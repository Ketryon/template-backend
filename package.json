    "ioredis": "^5.4.1",
    "postgres": "^3.4.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.4",
